# Copie para .env e preencha. O .env nunca vai para o git.

# YCloud (painel > Developers). A chave dá acesso ao envio de mensagens: trate como senha.
YCLOUD_API_KEY=
# Segredo do endpoint de webhook criado na YCloud (usado para conferir a assinatura de cada evento).
YCLOUD_WEBHOOK_SECRET=
# Número do WhatsApp da empresa, com código do país. Ex.: +5511999999999
WHATSAPP_NUMERO=

# Enquanto a tabela de preços for fictícia, o bot só responde a estes números (separados por vírgula).
NUMEROS_TESTE=

# 0 = custo zero: o bot só responde conversas vindas de anúncio (72h gratuitas); as demais ficam para o vendedor.
# 1 = o bot responde a todos; fora da janela gratuita a Meta cobra por mensagem.
BOT_SEM_ANUNCIO=0

# Opcional: aviso no celular da equipe pelo app ntfy. Use um nome longo e difícil de adivinhar.
NTFY_TOPICO=

PORTA=3000
DADOS_DIR=data
