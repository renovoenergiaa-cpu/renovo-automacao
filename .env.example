# Copie para .env e preencha. O .env nunca vai para o git.

# --- WAHA (WhatsApp por QR code). Com WAHA_URL preenchido, o bot usa o WAHA e ignora a YCloud. ---
# Endereço do WAHA visto pelo bot. Com docker compose: http://waha:3000
WAHA_URL=http://waha:3000
# Três segredos que você inventa (longos e diferentes entre si): chave da API, assinatura do webhook e senha do painel.
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_PAINEL_SENHA=
# Só em servidor ARM (Oracle Ampere A1): descomente a linha abaixo.
# WAHA_IMAGEM=devlikeapro/waha:arm
# Nome da sessão no WAHA (o padrão serve).
WAHA_SESSAO=default

# --- YCloud (API oficial). Só vale com WAHA_URL vazio. ---
# YCloud (painel > Developers). A chave dá acesso ao envio de mensagens: trate como senha.
YCLOUD_API_KEY=
# Segredo do endpoint de webhook criado na YCloud (usado para conferir a assinatura de cada evento).
YCLOUD_WEBHOOK_SECRET=
# Número do WhatsApp da empresa, com código do país. Ex.: +5511999999999
WHATSAPP_NUMERO=

# Enquanto a tabela de preços não for aprovada, o bot só responde a estes números (separados por vírgula).
NUMEROS_TESTE=

# 0 = o bot só responde conversas vindas de anúncio; as demais ficam para o vendedor.
# 1 = o bot responde a todos. Na YCloud, fora da janela gratuita de 72h a Meta cobra por mensagem.
# No WAHA não há cobrança, mas a detecção de anúncio ainda não foi conferida com mensagem real: teste com NUMEROS_TESTE.
BOT_SEM_ANUNCIO=0

# Opcional: aviso no celular da equipe pelo app ntfy. Use um nome longo e difícil de adivinhar.
NTFY_TOPICO=

PORTA=3000
DADOS_DIR=data
